CompileFlags:
  CompilationDatabase: build/
Diagnostics:
  UnusedIncludes: Strict
  MissingIncludes: Strict
  Includes:
    IgnoreHeader: ['stm32[^/]*\.h', 'core_cm[^/]*\.h', 'cmsis_[^/]*\.h']
  ClangTidy:
    Add: []
    Remove: []
InlayHints:
  Enabled: Yes
  ParameterNames: No
  DeducedTypes: No
